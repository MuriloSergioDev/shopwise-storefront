# Seals the session cookie (min 32 chars). `nuxt dev` writes a random one to .env when missing.
NUXT_SESSION_PASSWORD=
# Service base URLs (defaults are the Tilt port-forwards).
NUXT_IDENTITY_URL=http://localhost:8101
NUXT_CATALOG_URL=http://localhost:8102
NUXT_PRICING_URL=http://localhost:8104
NUXT_CART_URL=http://localhost:8105
NUXT_CHECKOUT_URL=http://localhost:8106
NUXT_ORDERS_URL=http://localhost:8108
# Stripe test-mode publishable key (pk_test_…). Empty: the payment step offers test cards for payments' fake gateway.
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Offer Stripe's test payment methods (pm_card_visa, pm_card_chargeDeclined) when there is no publishable key.
# On by default in `nuxt dev`, off in builds.
# NUXT_PUBLIC_TEST_CARDS=true
