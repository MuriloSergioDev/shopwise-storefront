{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "shopwise": { "source": { "source": "github", "repo": "MuriloSergioDev/shopwise-platform" } }
  },
  "enabledPlugins": { "shopwise@shopwise": true },
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Bash(pnpm check:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm vitest:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm install:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  }
}
